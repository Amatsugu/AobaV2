[
	{
		"label": "Debug .NET Core App",
		"adapter": "netcoredbg",
		"request": "launch",
		"program": "${ZED_WORKTREE_ROOT}/AobaServer/bin/Debug/net10.0/AobaServer.dll",
		"cwd": "${ZED_WORKTREE_ROOT}/AobaServer",
		"env": {
			"ASPNETCORE_ENVIRONMENT": "Development",
			"ASPNETCORE_URLS": "http://localhost:5243",
		},
		"build": {
			"command": "dotnet",
			"args": [
				"build",
				"${ZED_WORKTREE_ROOT}/AobaServer/AobaServer.csproj",
				"-p:Configuration=Debug",
				"-p:TargetFramework=net10.0",
			],
		},
	},
]
